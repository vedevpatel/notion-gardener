{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["cli.ts", "notion.ts", "detectors.ts", "report.ts", "fix.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
