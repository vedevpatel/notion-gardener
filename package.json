{
  "name": "notion-gardener",
  "version": "0.1.0",
  "description": "Audit a Notion workspace for stale, empty, untitled, and duplicate pages. Score its hygiene, then clean it up with your sign-off.",
  "type": "module",
  "bin": {
    "notion-gardener": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx cli.ts",
    "build": "tsc -p tsconfig.json",
    "scan": "tsx cli.ts scan",
    "fix": "tsx cli.ts fix",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "license": "MIT"
}
