# Create an internal integration at https://www.notion.so/my-integrations,
# then share the pages you want audited with it. Notion only shows an
# integration what you explicitly share.
NOTION_TOKEN=secret_your_token_here

# Pages untouched for this many days count as stale (default 90)
STALE_DAYS=90

# Optional: LLM cluster summaries (scan --summarize). Any OpenAI-compatible
# endpoint works. Without a key the flag is a no-op.
#OPENAI_API_KEY=sk-your_key_here
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-4o-mini
